# Template for the .env file next to docker-compose.yml; copy to .env and fill in. Never commit .env.
COMPOSE_PROJECT_NAME=auction
ASPNETCORE_ENVIRONMENT=Production
SITE_ADDRESS=auction.example.com
HTTP_PORT=80
HTTPS_PORT=443
IMAGE_TAG=latest

POSTGRES_DB=auction
POSTGRES_USER=auction
POSTGRES_PASSWORD=

MINIO_ROOT_USER=
MINIO_ROOT_PASSWORD=

Email__Provider=Smtp
Email__From=no-reply@auction.example.com
Email__Smtp__Host=
Email__Smtp__Port=587
Email__Smtp__UserName=
Email__Smtp__Password=

Admin__Email=
Admin__Password=

Security__AllowedOrigins__0=https://auction.example.com
