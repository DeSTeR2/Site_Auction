{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    },
    "Console": {
      "FormatterName": "json",
      "FormatterOptions": {
        "IncludeScopes": true,
        "UseUtcTimestamp": true
      }
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "Postgres": "Host=localhost;Port=5432;Database=auction;Username=auction"
  },
  "Auction": {
    "MaxActiveLotsPerUser": 20,
    "MaxDraftsPerUser": 20,
    "MaxFavoritesPerUser": 200,
    "MaxBidAmount": 100000000,
    "AllowedDurationsDays": [ 1, 3, 5, 7, 10, 14 ],
    "AllowMinuteDurations": false,
    "CatalogPageSize": 24
  },
  "Bidding": {
    "RateLimits": {
      "PerUserPerMinute": 10,
      "PerLotPerMinute": 2
    }
  },
  "Security": {
    "AllowedOrigins": [],
    "AuthRequestsPerMinute": 20,
    "Session": {
      "CookieName": "auction_session",
      "Lifetime": "30.00:00:00",
      "RenewAfter": "00:05:00"
    }
  },
  "Storage": {
    "Provider": "Minio",
    "PublicBaseUrl": "/media",
    "Minio": {
      "Endpoint": "minio:9000",
      "Bucket": "media",
      "UseSsl": false
    }
  },
  "Email": {
    "Provider": "Smtp",
    "From": "no-reply@auction.local",
    "FileDirectory": "mail-drop",
    "Smtp": {
      "Host": "localhost",
      "Port": 587
    }
  }
}
